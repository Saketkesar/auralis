# AURALIS VISION — GPU worker image.
# Used by the `celery-gpu` service (NVIDIA container runtime) in docker-compose.yml.
# Built on the CUDA runtime so PyTorch/ONNX can use the GPU for GEOINT, landmark,
# object, face, tampering, AI-image, and deepfake stages.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        build-essential \
        libpq-dev \
        libmagic1 \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN useradd --create-home --uid 10001 auralis \
    && chown -R auralis:auralis /app
USER auralis

CMD ["celery", "-A", "app.worker.celery_app", "worker", "--queues=gpu", "--concurrency=1"]
